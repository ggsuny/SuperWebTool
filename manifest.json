{
  "manifest_version": 3,
  "name": "Page Inline Translator",
  "description": "Translate English webpages in-place with replace or bilingual inline mode.",
  "version": "0.1.0",
  "permissions": ["activeTab", "contextMenus", "downloads", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "http://localhost/*", "http://127.0.0.1/*"],
  "action": {
    "default_title": "Translate this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf-extractor.html",
        "src/pdf-extractor.js",
        "vendor/pdf.min.js",
        "vendor/pdf.worker.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "save_page": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "保存当前页面笔记"
    },
    "translate_current_page": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "Alt+Shift+T"
      },
      "description": "打开页面阅读助手并开始翻译"
    },
    "mark_selection": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Alt+X"
      },
      "description": "标记当前选中文本并发送到笔记"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
